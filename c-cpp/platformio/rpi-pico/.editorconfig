# EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,cxx,cc,c,h,hpp,hxx}]
indent_style = space
indent_size = 4

[*.{json,yaml,yml,toml,md,rst,ini,txt}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.{png,jpg,jpeg,gif,ico,svg,bin,hex,elf}]
insert_final_newline = unset
trim_trailing_whitespace = unset
