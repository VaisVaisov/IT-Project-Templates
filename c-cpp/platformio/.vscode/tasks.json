        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      }
    },
    {
      "label": "PlatformIO: Upload",
      "type": "shell",
      "command": "pio run --target upload",
      "problemMatcher": [],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      }
    },
    {
      "label": "PlatformIO: Upload + Monitor",
      "type": "shell",
      "command": "pio run --target upload && pio device monitor",
