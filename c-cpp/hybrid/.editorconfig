# EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,cxx,cc,c,h,hpp,hxx}]
indent_style = space
indent_size = 4

[*.{py,pyx,pxd}]
indent_style = space
indent_size = 4

[*.{js,ts,json,yaml,yml,toml,md,rst,cmake,txt}]
indent_style = space
indent_size = 2

[CMakeLists.txt]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

[*.{png,jpg,jpeg,gif,ico,svg,woff,woff2,ttf,eot,bin,so,a,o}]
insert_final_newline = unset
trim_trailing_whitespace = unset
