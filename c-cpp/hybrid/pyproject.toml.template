[project]
name = "@PROJECT_NAME@"
# ADAPT: Set your version, description, and Python requirement
version = "0.0.0"
description = ""
requires-python = ">=3.10"
# ADAPT: Add your project's runtime dependencies
dependencies = [
    "numpy",
    "cython",
]

[project.optional-dependencies]
# ADAPT: Add extra dev tools if needed
dev = [
    "pytest",
    "pytest-cov",
    "snakeviz",
    "ruff",
    "pylint",
    "mypy",
    "py-spy",
    "sphinx",
    "furo",
    "breathe",
]

[tool.ruff]
line-length = 100

[tool.ruff.lint]
select = ["E", "F", "W", "I", "UP", "B", "C4", "RUF"]
ignore = ["E203"]

[tool.ruff.format]
quote-style = "double"

[tool.mypy]
ignore_missing_imports = true

[tool.pytest.ini_options]
testpaths = ["test/python"]

[tool.coverage.run]
source = ["python"]

[tool.coverage.report]
show_missing = true
