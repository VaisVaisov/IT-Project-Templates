{
  "name": "${localWorkspaceFolderBasename} - Hybrid (C/C++ + Python)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": [
    "--privileged"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "Alibaba-Cloud.tongyi-lingma",
        "kilocode.Kilo-Code",
        "ms-vscode.cpptools",
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cmake-tools",
        "vadimcn.vscode-lldb",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "njpwerner.autodocstring",
        "kevinrose.vsc-python-indent",
        "formulahendry.code-runner",
        "yzhang.markdown-all-in-one",
        "manuth.markdown-converter",
        "takumii.markdowntable",
        "redhat.vscode-yaml",
        "meezilla.json",
        "ms-azuretools.vscode-docker",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "streetsidesoftware.code-spell-checker",
        "aaron-bond.better-comments",
        "DavidAnson.vscode-markdownlint",
        "GitHub.vscode-pull-request-github"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": { "path": "/bin/zsh" },
          "bash": { "path": "/bin/bash" }
        },
        "files.eol": "\n",
        "files.insertFinalNewline": true,
        "files.trimTrailingWhitespace": true,
        "C_Cpp.default.compilerPath": "/usr/bin/clang++",
        "C_Cpp.default.cppStandard": "c++20",
        "C_Cpp.default.cStandard": "c17",
        "cmake.configureOnOpen": true,
        "cmake.generator": "Ninja",
        "python.defaultInterpreterPath": "/usr/bin/python",
        "terminal.integrated.fontFamily": "CaskaydiaCove Nerd Font"
      }
    }
  },
  "remoteUser": "vscode",
  "mounts": [
    "source=${localWorkspaceFolderBasename}-bashhistory,target=/commandhistory,type=volume",
    "source=${localWorkspaceFolderBasename}-claude-config,target=/home/vscode/.claude,type=volume",
    "source=${localEnv:HOME}/.config/gh,target=/home/vscode/.config/gh,type=bind,consistency=cached"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "DEVCONTAINER": "true"
  },
  "postCreateCommand": "git config --global credential.helper '!gh auth git-credential' && clang --version && python --version && claude --version && pre-commit install && pre-commit install --hook-type commit-msg"
}
