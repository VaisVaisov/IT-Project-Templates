cmake_minimum_required(VERSION 3.24)
project(@PROJECT_NAME@ LANGUAGES C CXX)

# Language standards
set(CMAKE_C_STANDARD 11)
set(CMAKE_C_STANDARD_REQUIRED ON)
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

# Output directories
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY ${CMAKE_SOURCE_DIR}/bin)
set(CMAKE_LIBRARY_OUTPUT_DIRECTORY ${CMAKE_SOURCE_DIR}/lib)
set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY ${CMAKE_SOURCE_DIR}/lib)

# Enable testing
enable_testing()

# Setup googletest
if(EXISTS ${CMAKE_SOURCE_DIR}/libraries/googletest)
    add_subdirectory(libraries/googletest)
else()
    include(FetchContent)
    FetchContent_Declare(
        googletest
        URL https://github.com/google/googletest/archive/refs/tags/v1.14.0.zip
    )
    set(gtest_force_shared_crt ON CACHE BOOL "Always use msvcrt.dll" FORCE)
    FetchContent_MakeAvailable(googletest)
endif()

# C++ tests — add your test executables in test/cpp/
# Example:
# if(EXISTS ${CMAKE_SOURCE_DIR}/test/cpp/test_example.cpp)
#     add_executable(test_example test/cpp/test_example.cpp)
#     target_link_libraries(test_example GTest::gtest_main your_lib)
#     add_test(NAME test_example COMMAND test_example)
# endif()

# Setup Google Benchmark
if(EXISTS ${CMAKE_SOURCE_DIR}/libraries/googlebenchmark)
    set(BENCHMARK_ENABLE_TESTING OFF CACHE BOOL "" FORCE)
    add_subdirectory(libraries/googlebenchmark)
else()
    include(FetchContent)
    FetchContent_Declare(
        googlebenchmark
        URL https://github.com/google/benchmark/archive/refs/tags/v1.9.1.zip
    )
    set(BENCHMARK_ENABLE_TESTING OFF CACHE BOOL "" FORCE)
    FetchContent_MakeAvailable(googlebenchmark)
endif()

# Benchmarks — add your benchmark executables in benchmarks/
if(EXISTS ${CMAKE_SOURCE_DIR}/benchmarks/bench_example.cpp)
    add_executable(bench_example benchmarks/bench_example.cpp)
    target_link_libraries(bench_example benchmark::benchmark)
endif()
# Example for your own benchmarks:
# add_executable(bench_foo benchmarks/bench_foo.cpp)
# target_link_libraries(bench_foo benchmark::benchmark your_lib)
