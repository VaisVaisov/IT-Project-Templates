{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Claude YOLO",
      "type": "shell",
      "command": "claude --dangerously-skip-permissions",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": false,
        "focus": true
      }
    },
    {
      "label": "Qwen YOLO",
      "type": "shell",
      "command": "qwen --yolo",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": false,
        "focus": true
      }
    },
    {
      "label": "Kilo Code",
      "type": "shell",
      "command": "kilo",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": false,
        "focus": true
      }
    },
    {
      "label": "Run pre-commit (all files)",
      "type": "shell",
      "command": "pre-commit run --all-files",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      }
    },
    {
      "label": "Update pre-commit hooks",
      "type": "shell",
      "command": "pre-commit autoupdate",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      }
    },
    {
      "label": "CMake: Build Debug (Linux)",
      "type": "shell",
      "command": "cmake --preset linux-debug && cmake --build --preset linux-debug",
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      }
    },
    {
      "label": "CMake: Build Release (Linux)",
      "type": "shell",
      "command": "cmake --preset linux-release && cmake --build --preset linux-release",
      "problemMatcher": ["$gcc"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      }
    },
    {
      "label": "CMake: Build Windows (.exe)",
      "type": "shell",
      "command": "cmake --preset windows-cross && cmake --build --preset windows-cross",
      "problemMatcher": ["$gcc"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      }
    },
    {
      "label": "Run tests (C++)",
      "type": "shell",
      "command": "cd cmake-build-linux-debug && ctest --output-on-failure",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      }
    },
    {
      "label": "Sanitize: ASan",
      "type": "shell",
      "command": "cmake --preset linux-asan && cmake --build --preset linux-asan && cd cmake-build-linux-asan && ctest --output-on-failure",
      "problemMatcher": ["$gcc"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      }
    },
    {
      "label": "Sanitize: UBSan",
      "type": "shell",
      "command": "cmake --preset linux-ubsan && cmake --build --preset linux-ubsan && cd cmake-build-linux-ubsan && ctest --output-on-failure",
      "problemMatcher": ["$gcc"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      }
    },
    {
      "label": "Sanitize: TSan",
      "type": "shell",
      "command": "cmake --preset linux-tsan && cmake --build --preset linux-tsan && cd cmake-build-linux-tsan && ctest --output-on-failure",
      "problemMatcher": ["$gcc"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      }
    },
    {
      "label": "Sanitize: MSan",
      "type": "shell",
      "command": "cmake --preset linux-msan && cmake --build --preset linux-msan && cd cmake-build-linux-msan && ctest --output-on-failure",
      "problemMatcher": ["$gcc"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      }
    },
    {
      "label": "Coverage: C++",
      "type": "shell",
      "command": "cmake --preset linux-coverage && cmake --build --preset linux-coverage && cd cmake-build-linux-coverage && ctest --output-on-failure && lcov --capture --directory . --output-file coverage.info && lcov --remove coverage.info '/usr/*' '*/libraries/*' '*/test/*' --output-file coverage.info && genhtml coverage.info --output-directory coverage-html",
      "problemMatcher": ["$gcc"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      }
    },
    {
      "label": "Profile: memcheck",
      "type": "shell",
      "command": "tools/profiler/run-memcheck.sh ${input:binaryName}",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      }
    },
    {
      "label": "Profile: callgrind",
      "type": "shell",
      "command": "tools/profiler/run-callgrind.sh ${input:binaryName}",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      }
    },
    {
      "label": "Profile: cachegrind",
      "type": "shell",
      "command": "tools/profiler/run-cachegrind.sh ${input:binaryName}",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      }
    },
    {
      "label": "Profile: massif",
      "type": "shell",
      "command": "tools/profiler/run-massif.sh ${input:binaryName}",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      }
    },
    {
      "label": "Profile: helgrind",
      "type": "shell",
      "command": "tools/profiler/run-helgrind.sh ${input:binaryName}",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      }
    },
    {
      "label": "Profile: drd",
      "type": "shell",
      "command": "tools/profiler/run-drd.sh ${input:binaryName}",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      }
    },
    {
      "label": "Profile: Run all",
      "type": "shell",
      "command": "scripts/profile.sh ${input:binaryName}",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      }
    }
  ],
  "inputs": [
    {
      "id": "binaryName",
      "type": "promptString",
      "description": "Binary name (from bin/)",
      "default": "my_binary"
    }
  ]
}
