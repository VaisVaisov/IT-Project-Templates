{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Claude YOLO",
      "type": "shell",
      "command": "claude --dangerously-skip-permissions",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": false,
        "focus": true
      }
    },
    {
      "label": "Qwen YOLO",
      "type": "shell",
      "command": "qwen --yolo",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": false,
        "focus": true
      }
    },
    {
      "label": "Kilo Code",
      "type": "shell",
      "command": "kilo",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": false,
        "focus": true
      }
    },
    {
      "label": "Run pre-commit (all files)",
      "type": "shell",
      "command": "pre-commit run --all-files",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      }
    },
    {
      "label": "Update pre-commit hooks",
      "type": "shell",
      "command": "pre-commit autoupdate",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      }
    },
    {
      "label": "CMake: Build Debug (Linux)",
      "type": "shell",
      "command": "cmake --preset linux-debug && cmake --build --preset linux-debug",
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      }
    },
    {
      "label": "CMake: Build Release (Linux)",
      "type": "shell",
      "command": "cmake --preset linux-release && cmake --build --preset linux-release",
      "problemMatcher": ["$gcc"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      }
    },
    {
      "label": "CMake: Build Windows (.exe)",
      "type": "shell",
      "command": "cmake --preset windows-cross && cmake --build --preset windows-cross",
      "problemMatcher": ["$gcc"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      }
    },
    {
      "label": "Run tests (C++)",
      "type": "shell",
      "command": "cd cmake-build-linux-debug && ctest --output-on-failure",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      }
    }
  ]
}
